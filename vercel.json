{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/quienessomos", "destination": "/equipo/", "permanent": true },
    { "source": "/cursos", "destination": "/formacion/", "permanent": true },
    { "source": "/galeria", "destination": "/equipo/", "permanent": true },
    { "source": "/descripciontratamiento", "destination": "/tratamientos/", "permanent": true },
    { "source": "/services-1", "destination": "/tratamientos/", "permanent": true }
  ],
  "headers": [{
    "source": "/(.*)",
    "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'" }
    ]
  }]
}
